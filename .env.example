# Copy this file to .env and fill in real values for local dev.
# Used by both docker-compose.yml (Postgres container) and backend/app/config.py.

# --- Postgres ---
POSTGRES_USER=ticketsense
POSTGRES_PASSWORD=ticketsense
POSTGRES_DB=ticketsense
POSTGRES_PORT=5432

# Full SQLAlchemy async URL — must stay in sync with the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://ticketsense:ticketsense@localhost:5432/ticketsense

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend cross-role synchronization ---
# How often (ms) authenticated views re-fetch authoritative ticket/queue state from
# the API while the tab is visible. The database remains the single source of truth;
# this only controls polling cadence, not any client-side optimistic state.
VITE_SYNC_POLL_INTERVAL_MS=15000

# --- Grounded draft provider ---
# stub/deterministic/development (the default) use the clearly-labelled, no-network
# evidence template and require no key — the app works fully without any of the
# settings below configured. Set LLM_PROVIDER=openai_compatible (or openai) to use a
# real OpenAI-compatible chat-completions API (OpenAI itself, Azure, or a
# self-hosted/local server implementing the same contract) for drafting and the
# description assistant; LLM_API_KEY is then required — the provider fails closed,
# never silently, if it's missing. Any other LLM_PROVIDER value fails closed too.
# Never commit a real key; this file only ever holds local placeholders.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Bounds classifier/embedding-model load + inference in the LangGraph classify/retrieve
# nodes, so a slow or unreachable Hugging Face Hub download fails the request instead of
# hanging it indefinitely. Generous by default to allow a legitimate first-time download.
MODEL_LOAD_TIMEOUT_SECONDS=120

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Secure attachments and OCR ---
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_PDF_PAGES=25
ATTACHMENT_MAX_EXTRACTED_CHARS=50000
ATTACHMENT_CONTEXT_CHARS=8000
ATTACHMENT_MAX_IMAGE_PIXELS=25000000
ATTACHMENT_STORAGE_ROOT=uploads/attachments
ATTACHMENT_EXTRACTION_TIMEOUT_SECONDS=30

# --- Auth ---
# Generate your own for real use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-generate-a-real-secret-per-above
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_EXPIRE_DAYS=14
# Set true only when the browser reaches the API over HTTPS.
COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
SESSION_CLEANUP_INTERVAL_SECONDS=3600
# General per-client-IP abuse throttle across all endpoints (not the account-specific
# login lockout above). Keyed by client host, so keep this generous enough that shared
# NAT/corporate-proxy traffic and a dashboard's own multi-tab auto-refresh polling never
# trip it during normal use.
GENERAL_RATE_LIMIT_REQUESTS=600
GENERAL_RATE_LIMIT_WINDOW_SECONDS=60
