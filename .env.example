# Copy this file to .env and fill in real values for local dev.
# Used by both docker-compose.yml (Postgres container) and backend/app/config.py.

# --- Postgres ---
POSTGRES_USER=ticketsense
POSTGRES_PASSWORD=ticketsense
POSTGRES_DB=ticketsense
POSTGRES_PORT=5432

# Full SQLAlchemy async URL — must stay in sync with the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://ticketsense:ticketsense@localhost:5432/ticketsense

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Grounded draft provider ---
# stub/deterministic/development use the clearly-labelled, no-network evidence template.
# Other values fail closed until a concrete provider adapter is configured.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Bounds classifier/embedding-model load + inference in the LangGraph classify/retrieve
# nodes, so a slow or unreachable Hugging Face Hub download fails the request instead of
# hanging it indefinitely. Generous by default to allow a legitimate first-time download.
MODEL_LOAD_TIMEOUT_SECONDS=120

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Secure attachments and OCR ---
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_PDF_PAGES=25
ATTACHMENT_MAX_EXTRACTED_CHARS=50000
ATTACHMENT_CONTEXT_CHARS=8000
ATTACHMENT_MAX_IMAGE_PIXELS=25000000
ATTACHMENT_STORAGE_ROOT=uploads/attachments
ATTACHMENT_EXTRACTION_TIMEOUT_SECONDS=30

# --- Auth ---
# Generate your own for real use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-generate-a-real-secret-per-above
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_EXPIRE_DAYS=14
# Set true only when the browser reaches the API over HTTPS.
COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
SESSION_CLEANUP_INTERVAL_SECONDS=3600
